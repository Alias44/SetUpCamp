<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Release Current" />
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
  </Configurations>
  <Project Path="../../../../RimWorldWin64.exe">
    <BuildType Project="Release" />
    <Platform Project="x64" />
    <Properties Name="DebuggerProjectSystem">
      <Property Name="Arguments" Value="--doorstop-enabled true" />
      <Property Name="AttachLaunchAction" Value="No" />
      <Property Name="Environment" Value="Default" />
      <Property Name="Executable" Value="C:\Program Files (x86)\Games\Steam\steamapps\common\RimWorld\RimWorldWin64.exe" />
      <Property Name="IORedirection" Value="Auto" />
      <Property Name="LaunchingEngine" Value="00000000-0000-0000-0000-000000000000" />
      <Property Name="LaunchSQLEngine" Value="No" />
      <Property Name="PortSupplier" Value="00000000-0000-0000-0000-000000000000" />
      <Property Name="RemoteMachine" Value="$(computername)" />
      <Property Name="StartingDirectory" Value="C:\Program Files (x86)\Games\Steam\steamapps\common\RimWorld" />
      <Property Name="UseLegacyDebugEngines" Value="No" />
    </Properties>
  </Project>
  <Project Path="SetUpCamp.csproj">
    <BuildType Solution="Release|*" Project="Release Current" />
  </Project>
</Solution>
